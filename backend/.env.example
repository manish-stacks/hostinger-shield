# ==============================================================================
# Hostinger Shield Pro — Backend Environment Configuration
# Copy this file to `.env` and fill in your real values before running.
# ==============================================================================

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=6000
FRONTEND_URL=https://your-dashboard-domain.com

# ─── Database (MongoDB & Optional Redis) ───────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/shield?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# ─── Default Seed Admin (used ONLY on first boot when DB has 0 users) ──────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMeStrong@123

# ─── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate strong 64-char random secrets: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_jwt_secret
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email Alerts (SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_FROM="Hostinger Shield Pro <your-email@gmail.com>"

# ─── WhatsApp Alerts (WAAPI — Optional) ────────────────────────────────────────
WAAPI_URL=https://your-waapi-instance.com
WAAPI_TOKEN=your_waapi_token_here
WAAPI_INSTANCE_ID=your_instance_id_here
ALERT_PHONE=919999999999

# ─── Telegram Bot Alerts (Optional — Instant Alerts) ───────────────────────────
# Create a bot with @BotFather and get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Slack / Discord / Custom Webhook Alerts (Optional) ────────────────────────
ALERT_WEBHOOK_URL=

# ─── Hostinger API & Threat Intel ──────────────────────────────────────────────
HOSTINGER_API_BASE=https://developers.hostinger.com/api
# Optional: Google Safe Browsing API key (1 batch call per 500 sites/day)
GOOGLE_SAFE_BROWSING_KEY=

# ─── Monitoring Schedules & Timeouts ───────────────────────────────────────────
HEALTH_CHECK_MINUTES=5
FAST_SCAN_MINUTES=10
MONITOR_TIMEOUT_MS=15000
MONITOR_SLOW_MS=5000
ESCALATE_MINUTES=10
ESCALATE_MAX=4

# ─── Screenshots ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
EXPORT_DIR=./exports
SCREENSHOT_DIR=./screenshots
PUPPETEER_EXECUTABLE_PATH=
SCREENSHOT_KEEP_LATEST=2
SCREENSHOT_TIMEOUT_MS=25000
SCREENSHOT_CHANGE_PCT=15
SCREENSHOT_QUALITY=60

# ─── Database Storage Guard & Auto-Retention (Prevents Atlas 512MB Overflow) ───
# Set DB_MAX_MB=380 for MongoDB Atlas M0 (512MB free tier) so auto-cleanup fires early
DB_MAX_MB=380
# Save a WebsiteHealth snapshot at most once every N minutes (status flips always save immediately)
HEALTH_SAVE_MINUTES=60
# Hard cap per website — guarantees DB size can NEVER explode
MAX_HEALTH_PER_SITE=48
MAX_SSL_PER_SITE=5
MAX_DNS_PER_SITE=10

# Retention windows in days
RETAIN_HEALTH_DAYS=7
RETAIN_THREAT_RESOLVED_DAYS=14
RETAIN_THREAT_OPEN_DAYS=60
RETAIN_SSL_DAYS=30
RETAIN_DNS_DAYS=30
RETAIN_INCIDENT_DAYS=45
RETAIN_NOTIF_READ_DAYS=3
RETAIN_NOTIF_DAYS=10
RETAIN_SCREENSHOT_LOG_DAYS=7
RETAIN_EVIDENCE_DAYS=14
RETAIN_REPORT_DAYS=21
RETAIN_FILES_DAYS=14
